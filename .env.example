# ==========================================
# Tahseel (تحصيل) — Environment Configuration
# ==========================================

# 1. AI Vision & Language Models (Google Gemini)
# Get your free key at: https://aistudio.google.com
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# 2. Database Connection
# Default: Local zero-config SQLite file
DATABASE_URL=sqlite:///./data/tahseel.db
# Optional PostgreSQL / Supabase connection:
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# 3. Optional: Live Email Dispatch (Resend)
# Leave empty to run in zero-friction Simulation Mode
RESEND_API_KEY=
FROM_EMAIL=collections@tahseel.local

# 4. Optional: Agent Observability (LangSmith Tracing)
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=tahseel

# 5. Frontend Public Endpoints
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws/agent
